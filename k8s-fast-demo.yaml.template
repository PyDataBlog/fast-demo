apiVersion: v1
kind: Namespace
metadata:
  name: demo
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fast-demo-deployment
  namespace: demo
  labels:
    app: fast-demo
spec:
  replicas: 1
  selector:
    matchLabels:
      app: fast-demo
  template:
    metadata:
      labels:
        app: fast-demo
    spec:
      containers:
        - name: fast-demo
          image: fast-demo:{{API_VERSION}}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8000
          env:
            - name: PYTHONUNBUFFERED
              value: "1"
            - name: API_VERSION
              value: "{{API_VERSION}}"
---
apiVersion: v1
kind: Service
metadata:
  name: fast-demo-service
  namespace: demo
spec:
  selector:
    app: fast-demo
  ports:
    - protocol: TCP
      port: 8000
      targetPort: 8000
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: fast-demo-gateway
  namespace: demo
spec:
  gatewayClassName: nginx
  listeners:
  - name: http
    hostname: "{{K8S_INGRESS_IP}}.nip.io"
    port: 80
    protocol: HTTP
    allowedRoutes:
      namespaces:
        from: All
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: fast-demo-httproute
  namespace: demo
spec:
  parentRefs:
  - name: fast-demo-gateway
    namespace: demo
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /api
    backendRefs:
    - name: fast-demo-service
      port: 8000
